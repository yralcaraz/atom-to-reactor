# Copy to `.env` (git-ignored) and fill in. The code reads these through kinetics/paths.py;
# no real path is ever written in the repository.

# Folder with the private data, laid out as in the repository (data/, results/, tests/).
# Holds the unpublished Tank snapshot (P. Broqvist), the curated lab observables and the per-spectrum tables.
ATOM_PRIVATE_DIR=<path to the private data folder>

# Folder with the raw lab NMR spectra (JEOL .jdf files, N. Gogoi, unpublished).
LAB_NMR_DIR=<path to the raw lab spectra folder>

# Only for the project-management script kept in the private folder (Linear).
# LINEAR_API_KEY=<your key>
